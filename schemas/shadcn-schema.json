{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/shadcn-schema.json",
  "title": "shadcn components config",
  "type": "object",
  "required": ["style", "rsc", "tsx", "tailwind", "aliases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "style": {
      "type": "string",
      "enum": ["default", "new-york"]
    },
    "rsc": {
      "type": "boolean"
    },
    "tsx": {
      "type": "boolean"
    },
    "tailwind": {
      "type": "object",
      "required": ["config", "css", "baseColor", "cssVariables", "prefix"],
      "properties": {
        "config": { "type": "string" },
        "css": { "type": "string" },
        "baseColor": { "type": "string" },
        "cssVariables": { "type": "boolean" },
        "prefix": { "type": "string" }
      },
      "additionalProperties": true
    },
    "aliases": {
      "type": "object",
      "required": ["components", "utils", "ui", "lib", "hooks"],
      "properties": {
        "components": { "type": "string" },
        "utils": { "type": "string" },
        "ui": { "type": "string" },
        "lib": { "type": "string" },
        "hooks": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
