# ---------------------------------------------------------------------------
# eShifa website — environment configuration
#
# Copy to `.env.local` for local development. `.env.local` is gitignored and
# must never be committed. This file holds placeholder values only.
#
# This is the public website. It holds NO privileged credentials: the forms
# write to the database through single-purpose functions using the browser-safe
# publishable key, and nothing in this app can read a submitted record back.
# The admin portal is a separate application with its own configuration.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, Open Graph tags, sitemap and JSON-LD.
# Set this per environment so preview deployments do not emit production URLs.
# Falls back to https://eshifa.org when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:22421

# --- Supabase (form storage) --------------------------------------------
# Supabase Dashboard -> Project Settings -> API Keys
#
# The publishable key is safe in the browser: it carries no privileges of its
# own, so every request it makes is still filtered by Row Level Security.
# Newer Supabase projects issue `sb_publishable_...`; older ones issue a JWT
# named "anon". Either variable name works — set whichever your project shows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key   # legacy alternative

# --- Email (optional) -----------------------------------------------------
# Without RESEND_API_KEY nothing is sent: the site logs what it would have
# sent and carries on. Forms keep working either way.
#
# EMAIL_FROM must be on a domain verified with the provider, or every message
# is rejected. EMAIL_TEAM_INBOX receives the internal alerts; leave it unset
# and only the applicant thank-you is sent.
RESEND_API_KEY=re_your_key
EMAIL_FROM=eShifa <noreply@eshifa.org>
EMAIL_TEAM_INBOX=partnerships@eshifa.org

# --- Operations (optional) ------------------------------------------------
# Bearer token for GET /api/health?check=config. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In production the check is switched off entirely while this is unset.
HEALTH_CHECK_TOKEN=

# Reverse proxies in front of the app that append the client address to
# X-Forwarded-For. 1 for a single load balancer or nginx (and the right value
# on Vercel, which rewrites the header itself). 0 when Node is reached
# directly: then no address header is trusted at all.
TRUSTED_PROXY_HOPS=1

# Shared rate-limit store so limits hold across serverless instances. Leave
# both unset to use the per-instance in-memory limiter. The database functions
# enforce their own per-phone and per-email throttles either way.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Every limit below has a sensible default (see src/lib/security-config.ts).
# Override only what you need, e.g.:
# RATE_LIMIT_CALLBACK_SUBMIT_MAX=3
# RATE_LIMIT_CALLBACK_SUBMIT_WINDOW_MS=600000
# RATE_LIMIT_CALLBACK_FLOOD_MAX=40
# RATE_LIMIT_PARTNERSHIP_SUBMIT_MAX=3
# RATE_LIMIT_PARTNERSHIP_FLOOD_MAX=40
# RATE_LIMIT_CAPTCHA_MAX=30
# RATE_LIMIT_HEALTH_MAX=60
# CALLBACK_MAX_BODY_BYTES=8192
# PARTNERSHIP_MAX_BODY_BYTES=16384
# DATABASE_TIMEOUT_MS=8000
