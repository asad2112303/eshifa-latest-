# ---------------------------------------------------------------------------
# eShifa — environment configuration
#
# Copy to `.env.local` for local development. `.env.local` is gitignored and
# must never be committed. This file holds placeholder values only.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, Open Graph tags, sitemap and JSON-LD.
# Set this per environment so preview deployments do not emit production URLs.
# Falls back to https://eshifa.org when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:22421
