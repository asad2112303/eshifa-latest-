# ---------------------------------------------------------------------------
# eShifa — environment configuration
#
# Copy to `.env.local` for local development. `.env.local` is gitignored and
# must never be committed. This file holds placeholder values only.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, Open Graph tags, sitemap and JSON-LD.
# Set this per environment so preview deployments do not emit production URLs.
# Falls back to https://eshifa.org when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:22421

# --- Supabase (callback storage + admin portal) --------------------------
# Supabase Dashboard -> Project Settings -> API Keys
#
# The publishable key is safe in the browser: it carries no privileges of its
# own, so every request it makes is still filtered by Row Level Security.
# Newer Supabase projects issue `sb_publishable_...`; older ones issue a JWT
# named "anon". Either variable name works — set whichever your project shows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key   # legacy alternative

# Server-only key. Bypasses Row Level Security, so the admin API can read the
# requests. Required because the admin is not a Supabase user, so the database
# has no identity to authorize. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your-key

# --- Admin portal login --------------------------------------------------
# A single account. Generate all three with: npm run set-admin-password
# The password itself is never stored — only its scrypt hash.
ADMIN_EMAIL=admin@shifa.com.pk
ADMIN_PASSWORD_HASH=scrypt:...:...
ADMIN_SESSION_SECRET=random-32-bytes-base64url

