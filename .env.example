# ---------------------------------------------------------------------------
# eShifa — environment configuration
#
# Copy to `.env.local` for local development. `.env.local` is gitignored and
# must never be committed. This file holds placeholder values only.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, Open Graph tags, sitemap and JSON-LD.
# Set this per environment so preview deployments do not emit production URLs.
# Falls back to https://eshifa.org when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:22421

# --- Callback form -> Google Sheets -------------------------------------
# Spreadsheet ID: the long id in the sheet URL, between /d/ and /edit
GOOGLE_SHEETS_ID=1umT4Q3fnry0xlYrJ6JqJEWkVvd6qeu8ccIGuGDmdb9g

# Tab name to append to. Defaults to Sheet1 when unset.
GOOGLE_SHEETS_TAB=Sheet1

# Service account credentials (from the downloaded JSON key).
# NEVER commit the real values — set them in your hosting provider.
GOOGLE_SERVICE_ACCOUNT_EMAIL=eshifa-callbacks@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
